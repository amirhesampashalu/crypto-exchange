@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using crypto_exchange
@inject IHtmlLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
    var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
@model List<crypto_exchange.Models.CoinDto>
<!DOCTYPE html>
<html lang="@(isFa ? "fa" : "en")" dir="@(isFa ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Localizer["AppName"]</title>

    <link href="~/theme/converter.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/converter.css" asp-append-version="true" />
</head>
<body>

    <div class="app">
        <aside>
            <div class="brand">
                <i>₿</i>
                <div>
                    <b>@Localizer["AppName"]</b>
                    <small>@Localizer["Tagline"]</small>
                </div>
            </div>

            <nav>
                <a class="on" href="#"><span>⌂</span>@Localizer["NavHome"]</a>
                <a asp-action="Converter" asp-controller="Home"><span>⇄</span>@Localizer["NavConverter"]</a>
                <a href="#"><span>☆</span>@Localizer["NavFavorites"]</a>
                <a href="#"><span>⚙</span>@Localizer["NavSettings"]</a>
            </nav>

            <div class="api-note">
                <span class="dot"></span>
                @Localizer["LivePrices"]<br>
                @Localizer["DataSource"]
            </div>
        </aside>

        <div>
            <header class="top">
                <input id="search"
                       type="search"
                       placeholder="@Localizer["SearchPlaceholder"]"
                       aria-label="@Localizer["SearchAria"]">

                <div class="user">
                    <a asp-controller="Home" asp-action="SetLanguage"
                       asp-route-culture="@(isFa ? "en" : "fa")"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       style="margin-inline-end:12px;font-weight:700;">
                        @(isFa ? "EN" : "FA")
                    </a>
                    <i>👤</i>
                    <span>@Localizer["Guest"]</span>
                </div>
            </header>

            <main>
                <section class="card hero" id="conv">
                    <div>
                        <small class="welcome">@Localizer["Welcome"]</small>

                        <h1>
                            @Localizer["HeroLine1"]<br>
                            @Localizer["HeroLine2"]
                        </h1>

                        <p>
                            @Localizer["HeroDesc"]
                        </p>

                        <div class="meta">
                            <span>
                                @Localizer["LastUpdate"]
                                <b id="updated" class="ltr">—</b>
                            </span>

                            <span>
                                <span class="dot"></span>
                                @Localizer["LivePrice"]
                            </span>
                        </div>
                    </div>

                    <div class="conv">
                        <div class="field">
                            <label for="amount">@Localizer["From"]</label>

                            <div class="row">
                                <img class="ico" id="icoFrom" alt="">

                                <select id="from" aria-label="@Localizer["FromCoinAria"]"></select>

                                <input id="amount"
                                       type="number"
                                       value="1"
                                       min="0"
                                       step="any"
                                       inputmode="decimal"
                                       aria-label="@Localizer["Amount"]">
                            </div>
                        </div>

                        <button class="swap"
                                id="swap"
                                aria-label="@Localizer["SwapAria"]">
                            ⇅
                        </button>

                        <div class="field">
                            <label for="result">@Localizer["To"]</label>

                            <div class="row">
                                <img class="ico" id="icoTo" alt="">

                                <select id="to" aria-label="@Localizer["ToCoinAria"]"></select>

                                <input id="result" readonly>
                            </div>
                        </div>

                        <div class="rate">
                            <span>@Localizer["ConvRate"]</span>
                            <span id="rateTxt" class="ltr">—</span>
                        </div>

                        <div class="err" id="err" role="alert"></div>

                        <button class="btn" id="go">@Localizer["Convert"]</button>
                    </div>
                </section>

                <section class="card globe">
                    <h3>@Localizer["GlobalMarket"]</h3>
                    <p id="globalTxt">@Localizer["Loading"]</p>
                </section>

                <section class="card chart">
                    <div class="ch-head">
                        <div class="pair">
                            <img id="chImg" alt="">

                            <div>
                                <b id="chPair" class="ltr">—</b><br>
                                <small id="chName">—</small>
                            </div>
                        </div>

                        <div class="rng" id="rng">
                            <button type="button" data-d="1" class="on">1D</button>
                            <button type="button" data-d="7">1W</button>
                            <button type="button" data-d="30">1M</button>
                            <button type="button" data-d="90">3M</button>
                            <button type="button" data-d="365">1Y</button>
                        </div>
                    </div>

                    <div class="price">
                        <b id="chPrice">—</b>
                        <span id="chPct"></span>
                    </div>

                    <div class="plot">
                        <canvas id="cv" aria-label="@Localizer["ChartAria"]"></canvas>

                        <div class="stats">
                            <div>
                                <small>@Localizer["High"]</small>
                                <b class="up" id="hi">—</b>
                            </div>

                            <div>
                                <small>@Localizer["Low"]</small>
                                <b class="down" id="lo">—</b>
                            </div>

                            <div>
                                <small>@Localizer["RangeChange"]</small>
                                <b id="chg">—</b>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="bottom" id="rates">
                    <section class="card">
                        <h4>@Localizer["Popular"]</h4>
                        <div class="pop" id="pop"></div>
                    </section>

                    <section class="card">
                        <h4>@Localizer["RecentRates"]</h4>

                        <table>
                            <thead>
                                <tr>
                                    <th>@Localizer["Pair"]</th>
                                    <th class="n">@Localizer["Rate"]</th>
                                    <th class="n">@Localizer["Change"]</th>
                                </tr>
                            </thead>

                            <tbody id="recent"></tbody>
                        </table>
                    </section>

                    <section class="card hist">
                        <h4>@Localizer["HistRates"]</h4>
                        <p>@Localizer["HistDesc"]</p>
                        <button type="button" class="btn chart-scroll-btn">@Localizer["ViewChart"]</button>
                    </section>
                </div>

                <section class="card top-coins">
                    <h4>@Localizer["TopCoins"]</h4>

                    <table>
                        <thead>
                            <tr>
                                <th>@Localizer["Coin"]</th>
                                <th class="n">@Localizer["Price"]</th>
                                <th class="n">@Localizer["Change24h"]</th>
                            </tr>
                        </thead>

                        <tbody id="top">
                            @if (Model != null && Model.Count > 0)
                            {
                                @foreach (var coin in Model)
                                {
                                    <tr data-id="@coin.Id">
                                        <td>
                                            <div class="coin">
                                                <img src="@coin.Image" alt="@coin.Name">
                                                <span>@coin.Symbol.ToUpperInvariant()</span>
                                            </div>
                                        </td>

                                        <td class="n">
                                            @(coin.CurrentPrice?.ToString("N2") ?? "—")
                                        </td>

                                        <td class="n @(coin.Change24h >= 0 ? "up" : "down")">
                                            @(coin.Change24h?.ToString("+0.00;-0.00") ?? "—")%
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">@Localizer["NoData"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </main>
        </div>
    </div>

    <script>
        window.I18N = {
            totalCap: @Json.Serialize(Localizer["TotalCap"].Value),
            vol24: @Json.Serialize(Localizer["Vol24"].Value),
            btcDom: @Json.Serialize(Localizer["BtcDom"].Value),
            loading: @Json.Serialize(Localizer["Loading"].Value),
            rateLimit: @Json.Serialize(Localizer["RateLimit"].Value),
            pricesFailed: @Json.Serialize(Localizer["PricesFailed"].Value),
            noCoin: @Json.Serialize(Localizer["NoCoinFound"].Value),
            invalidAmount: @Json.Serialize(Localizer["InvalidAmount"].Value),
            convertFailed: @Json.Serialize(Localizer["ConvertFailed"].Value),
            chartLoading: @Json.Serialize(Localizer["ChartLoading"].Value),
            chartFailed: @Json.Serialize(Localizer["ChartFailed"].Value),
            marketUnavailable: @Json.Serialize(Localizer["MarketUnavailable"].Value)
        };
    </script>
    <script src="~/theme/converter.js" asp-append-version="true"></script>
</body>
</html>
